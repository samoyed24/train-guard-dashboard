# Image tags generated by CI
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/train-guard-dashboard/backend:dev
FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/train-guard-dashboard/frontend:dev
POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/postgres:16-alpine
REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/redis:7-alpine

# Runtime ports on dev server
FRONTEND_PORT=80
BACKEND_PORT=8000

# Backend settings
SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=120
FLASK_DEBUG=0
CORS_ORIGINS=http://<your-dev-host>

# Database settings
POSTGRES_DB=train_guard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
