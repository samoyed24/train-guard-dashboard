# Image tags generated by CI
BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/train-guard-dashboard/backend:dev
FRONTEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/train-guard-dashboard/frontend:dev
WORKER_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/train-guard-dashboard/worker:dev
POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/postgres:16-alpine
REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/redis:7-alpine
KAFKA_IMAGE=bitnami/kafka:3.7
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_METRICS_TOPIC=train-guard.metrics.ingest
KAFKA_CONSUMER_GROUP_ID=train-guard-worker
KAFKA_CONSUMER_MIN_BYTES=1000
KAFKA_CONSUMER_MAX_BYTES=10000000
KAFKA_CONSUMER_MAX_WAIT=1s
KAFKA_CONSUMER_AUTO_COMMIT=true

# Runtime ports on dev server
FRONTEND_PORT=80
BACKEND_PORT=8000

# Backend settings
SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=120
FLASK_DEBUG=0
CORS_ORIGINS=http://<your-dev-host>

# Database settings
POSTGRES_DB=train_guard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
