FLASK_ENV=development
SECRET_KEY=change-me
JWT_EXPIRES_MINUTES=120
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/train_guard
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your-account@example.com
SMTP_PASSWORD=your-password
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=your-account@example.com
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_METRICS_TOPIC=train-guard.metrics.ingest
KAFKA_PRODUCER_ACKS=1
KAFKA_PRODUCER_LINGER_MS=10
KAFKA_PRODUCER_RETRIES=3
KAFKA_SEND_TIMEOUT_SECONDS=3
