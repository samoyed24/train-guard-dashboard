DATABASE_URL=postgresql://postgres:postgres@localhost:5432/train_guard
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_METRICS_TOPIC=train-guard.metrics.ingest
KAFKA_CONSUMER_GROUP_ID=train-guard-worker
KAFKA_CONSUMER_MIN_BYTES=1000
KAFKA_CONSUMER_MAX_BYTES=10000000
KAFKA_CONSUMER_MAX_WAIT=1s
KAFKA_CONSUMER_AUTO_COMMIT=true
